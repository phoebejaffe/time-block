# Google Cloud OAuth Web client ID (required)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional API key for gapi.client.init (OAuth token alone is enough for Calendar calls)
# VITE_GOOGLE_API_KEY=

# Optional override for the token-exchange function (defaults to the deployed one)
# VITE_AUTH_ENDPOINT=https://us-west1-time-blocker-502417.cloudfunctions.net/auth

# Firebase web app config (required for cross-device sync via Firestore)
# Create at https://console.firebase.google.com → Project settings → Your apps
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
