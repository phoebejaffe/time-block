# Google Cloud OAuth Web client ID (required)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional API key for gapi.client.init (OAuth token alone is enough for Calendar calls)
# VITE_GOOGLE_API_KEY=

# Optional override for the token-exchange function (defaults to the deployed one)
# VITE_AUTH_ENDPOINT=https://us-west1-time-blocker-502417.cloudfunctions.net/auth
